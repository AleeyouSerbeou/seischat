# PostgreSQL connection URL used by SQLAlchemy and Alembic.
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/seischat

# Environment name: "development" or "production".
APP_ENVIRONMENT=development

# Exact browser origin allowed to call the API (no trailing slash).
FRONTEND_ORIGIN=http://localhost:5173

# Cookie names.
SESSION_COOKIE_NAME=seischat_session
CSRF_COOKIE_NAME=seischat_csrf

# Session lifetime in minutes.
SESSION_TTL_MINUTES=60

# Set true when serving over HTTPS outside local development.
CSRF_SECURE=false
